{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowcode Mobile",
  "version": "0.8.0",
  "identifier": "com.maxmoffa.flowcode.mobile",
  "build": {
    "beforeDevCommand": "npm run mobile:vite",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run mobile:vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flowcode Mobile",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["flowcode"], "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
