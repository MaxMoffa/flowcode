<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">
    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="250">
        <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    </ViewFlipper>
    <LinearLayout
        android:id="@+id/chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="9dp"
        android:background="@drawable/widget_glass_chip"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/chip_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="–"
            android:textColor="#fff6ea"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/chip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#D9fff6ea"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/chip_mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#B3fff6ea"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:id="@+id/new_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_accent_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_ic_plus" />
            <TextView
                android:id="@+id/new_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/widget_new"
                android:textColor="#0e0a07"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/new_fab"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_accent_round"
            android:contentDescription="@string/widget_cd_new"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_ic_plus"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/resume_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_ic_resume" />
            <TextView
                android:id="@+id/resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/widget_resume"
                android:textColor="#fff6ea"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/resume_round"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_glass_round"
            android:contentDescription="@string/widget_cd_resume"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_ic_resume"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
