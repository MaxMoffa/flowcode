<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">
    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="250">
        <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/f7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    </ViewFlipper>
    <LinearLayout
        android:id="@+id/chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="9dp"
        android:background="@drawable/widget_glass_chip"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/chip_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="–"
            android:textColor="#fff6ea"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/chip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#D9fff6ea"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/col"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        >
        <ImageView
            android:id="@+id/mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_glass_round"
            android:contentDescription="@string/widget_cd_voice"
            android:padding="8dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/widget_ic_mic"
             />
        <ImageView
            android:id="@+id/fab"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_accent_round"
            android:contentDescription="@string/widget_cd_new"
            android:padding="10dp"
            
            android:src="@drawable/widget_ic_plus"
             />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/btn_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/mic_r"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_glass_round"
            android:contentDescription="@string/widget_cd_voice"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_ic_mic"
             />
        <ImageView
            android:id="@+id/fab_r"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_accent_round"
            android:contentDescription="@string/widget_cd_new"
            android:padding="10dp"
            
            android:src="@drawable/widget_ic_plus"
             />
    </LinearLayout>
</FrameLayout>
